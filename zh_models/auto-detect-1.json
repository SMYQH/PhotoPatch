{
  "jsonVersion": "1.0.0",
  "version": "2",
  "minAppVersion": "0",
  "shortName": "apnb",
  "name": "Autopilot Noise Blur",
  "category": "自动参数计算",
  "verb": "正在智能分析图像特征...",
  "autoModel": "apnb",
  "display": 0,
  "enabled": 1,
  "padding": [
    0,
    0
  ],
  "zeroCenter": 1,
  "inputs": {
    "input": "input",
    "mask": "dummy"
  },
  "parameterNames": [
    "noise",
    "blur"
  ],
  "backends": {
    "coreml": {
      "model": "imap",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "output"
          ]
        }
      }
    },
    "openvino": {
      "model": "imap",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ov.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "output"
          ]
        }
      }
    }
  }
}