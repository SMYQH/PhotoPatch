      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ov.tz2"
          ],
          "blocks": [
            48,
            48
          ],
          "outputs": [
            "modelOutput"
          ]
        }
      }
    },
    "coreml": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            48,
            48
          ],
          "outputs": [
            "modelOutput"
          ]
        }
      }
    }
  }
}