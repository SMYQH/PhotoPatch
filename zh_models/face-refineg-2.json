{
  "jsonVersion": "1.0.0",
  "version": "3",
  "minAppVersion": "0",
  "minCMLMacVersion": 10.16,
  "shortName": "gfrg",
  "name": "Face Perfect generative v3",
  "category": "人脸高清修复",
  "enabled": 1,
  "usefulRegion": 1.0,
  "padding": [
    0,
    0
  ],
  "zeroCenter": 3,
  "gui": {
    "minScale": 1,
    "maxScale": 1,
    "showScale": 0,
    "name": "人脸高保真超清重构",
    "displayPri": 1.0,
    "desc": "基于深度先验的人脸超高清五官重构模型",
    "parameters": {
      "param1": {
        "name": "处理强度",
        "guiType": "int",
        "default": 1.0,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Reduce blockiness and other compression artifacts. Higher values are better for low-bitrate input video.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "selectedFaces": {
        "default": []
      }
    }
  },
  "inputs": {
    "input0": "netInput"
  },
  "backends": {
    "openvino": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ov.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "onnx": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ox.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "coreml": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-rev1-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    }
  }
}