{
  "jsonVersion": "1.0.0",
  "version": "1",
  "minAppVersion": "0",
  "shortName": "draw_linear",
  "name": "Linear RAW",
  "category": "RAW 原始数据处理",
  "verb": "正在消除图像噪点...",
  "autoModel": "slsp_ap",
  "display": 1,
  "enabled": 1,
  "preflight": 1,
  "postflight": 0,
  "keepColor": 0,
  "gui": {
    "minScale": 1,
    "maxScale": 1,
    "showScale": 0,
    "name": "RAW 极致降噪",
    "displayPri": 1.0,
    "desc": "针对 RAW Bayer 数据的无损 AI 降噪模型",
    "parameters": {
      "param1": {
        "name": "降噪强度",
        "guiType": "int",
        "default": 0.5,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Reduce blockiness and other compression artifacts. Higher values are better for low-bitrate input video.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "param2": {
        "name": "锐化强度",
        "guiType": "int",
        "default": 0,
        "guiMax": 100,
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      }
    }
  },
  "inputs": {
    "param1_native": "param0",
    "param2_native": "param1",
    "input0": "netinput"
  },
  "backends": {
    "openvino": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ov.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "StatefulPartitionedCall/model/model/tf.clip_by_value/clip_by_value"
          ]
        }
      }
    },
    "openvino16": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ov.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "StatefulPartitionedCall/model/model/tf.clip_by_value/clip_by_value"
          ]
        }
      }
    },
    "onnx": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ox.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "model"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ox.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "model"
          ]
        }
      }
    },
    "coreml": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "Identity"
          ]
        }
      }
    },
    "tensorrt": {
      "model": "imn",
      "parallel": 0,
      "capabilities": [
        705,
        806,
        809
      ],
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-rt[C]-[R]-rt.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "model"
          ]
        }
      }
    }
  }
}