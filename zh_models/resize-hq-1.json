      "param1": {
        "name": "降噪强度",
        "guiType": "int",
        "default": 0,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Reduce blockiness and other compression artifacts. Higher values are better for low-bitrate input video.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "param2": {
        "name": "锐化强度",
        "guiType": "int",
        "default": 0,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Additional sharpening of the video. Higher values produce a sharper video but may introduce artifacts. Adjust this after the \"Deblock\" setting.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "param3": {
        "name": "消除压缩杂讯",
