            "tf.clip_by_value"
          ]
        },
        "4": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ox.tz",
            "gclc-v1-fp32-[H]x[W]-[S]x-ox.tz"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
            "netOutput",
            "tf.clip_by_value"
          ]
        }
      }
    },
    "coreml": {
      "model": "imcc",
      "parallel": 1,
      "minMacVersion": 10.16,
      "scales": {
        "2": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-mlc.tz",
            "gclc-v1-fp16-[H]x[W]-[S]x-mlc.tz"
          ],
          "blocks": [
            128,
