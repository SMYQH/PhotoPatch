{
  "jsonVersion": "1.0.0",
  "version": "1",
  "minAppVersion": "0",
  "shortName": "ghqv2",
  "blockOverlap": 70,
  "blockDiscard": 6,
  "enabled": 1,
  "keepColor": 0,
  "name": "High Fidelity V2",
  "category": "画质综合增强",
  "verb": "正在执行画质增强...",
  "autoModel": "ggn_ap",
  "gui": {
    "minScale": 1,
    "maxScale": 4,
    "showScale": 0,
    "name": "高保真极清超分 (High Fidelity)",
    "displayPri": 3.0,
    "desc": "最大限度保留原始纹理真实感的高保真超分模型",
    "parameters": {
      "scale": {
        "default": 1
      },
      "param1": {
        "name": "降噪强度",
        "guiType": "int",
        "default": 0,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Reduce the noise. Higher values produce a cleaner image but may remove details.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "param2": {
        "name": "锐化强度",
        "guiType": "int",
        "default": 0,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Additional sharpening. Higher values produce a sharper image but may introduce artifacts.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "param3": {
        "name": "消除压缩杂讯",
        "guiType": "int",
        "default": 0.3,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Reduce blockiness and compression artifacts. Higher values produce a cleaner image but may introduce distortion.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      }
    }
  },
  "inputs": {
    "param1": "pb",
    "param2": "pn",
    "param3": "pc",
    "input": "netInput",
    "cinput": "infer_input",
    "output": "infer_output",
    "gamma": "dummy"
  },
  "backends": {
    "openvino": {
      "model": "imcc",
      "parallel": 1,
      "scales": {
        "2": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ov.tz",
            "gclc-v1-fp16-[H]x[W]-[S]x-ov.tz"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
            "netOutput",
            "model/tf.clip_by_value/clip_by_value"
          ]
        },
        "4": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ov.tz",
            "gclc-v1-fp16-[H]x[W]-[S]x-ov.tz"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
            "netOutput",
            "model/tf.clip_by_value/clip_by_value"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imcc",
      "parallel": 1,
      "scales": {
        "2": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ox.tz",
            "gclc-v1-fp32-[H]x[W]-[S]x-ox.tz"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
