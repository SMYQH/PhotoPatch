          ]
        }
      }
    },
    "tensorrt": {
      "model": "imcc",
      "parallel": 0,
      "capabilities": [
        705,
        806,
        809
      ],
      "scales": {
        "2": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-[S]x-rt[C]-[R]-rt.tz2",
