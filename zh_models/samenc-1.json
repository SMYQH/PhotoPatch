{
  "jsonVersion": "1.0.0",
  "version": "1",
  "minAppVersion": "0",
  "shortName": "sam_encode",
  "name": "SAM Encode",
  "category": "RAW 原始数据处理",
  "verb": "正在消除图像噪点...",
  "autoModel": "slsp_ap",
  "enabled": 1,
  "preflight": 1,
  "postflight": 0,
  "keepColor": 0,
  "clamp": [
    -1,
    1
  ],
  "inputs": {
    "input0": "netInput"
  },
  "backends": {
    "openvino16": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "samenc-v[V]-fp16-[H]x[W]-ov.tz"
          ],
          "blocks": [
            1024,
            1024
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "onnx": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "samenc-v[V]-fp32-[H]x[W]-ox.tz"
          ],
          "blocks": [
            1024,
            1024
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "samenc-v[V]-fp16-[H]x[W]-ox.tz"
          ],
          "blocks": [
            1024,
            1024
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "coreml": {
      "model": "imn",
      "parallel": -1,
      "scales": {
        "1": {
          "nets": [
            "samenc-v1-fp16-[H]x[W]-rev1-mlc.tz"
          ],
          "blocks": [
            1024,
            1024
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "tensorrt": {
      "model": "imn",
      "parallel": 0,
      "capabilities": [
        705,
        806,
        809
      ],
      "scales": {
        "1": {
          "nets": [
            "samenc-v[V]-fp32-[H]x[W]-rt[C]-[R]-rt.tz2"
          ],
          "blocks": [
            1024,
            1024
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    }
  }
}