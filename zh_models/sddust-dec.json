{
  "jsonVersion": "1.0.0",
  "version": "2",
  "minCMLMacVersion": 10.16,
  "minAppVersion": "0",
  "shortName": "sddustdec",
  "name": "SDDustDecoder",
  "category": "灰尘微粒消除",
  "enabled": 1,
  "zeroCenter": 2,
  "padding": [
    0,
    0
  ],
  "blockOverlap": 24,
  "blockDiscard": 6,
  "inputs": {
    "input": "z",
    "cinput": "netRef",
    "output": "netInput"
  },
  "backends": {
    "coreml": {
      "model": "imcc",
      "parallel": 1,
      "scales": {
        "8": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-mlc.tz",
            "ldclc-v1-fp16-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            64,
            64
          ],
          "outputs": [
            "image",
            "netOutput"
          ]
        }
      }
    },
    "openvino": {
      "model": "imcc",
      "parallel": 1,
      "scales": {
        "8": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ov.tz",
            "ldclc-v1-fp16-[H]x[W]-ov.tz"
          ],
          "blocks": [
            64,
            64
          ],
          "outputs": [
            "image",
            "netOutput"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imcc",
      "parallel": 1,
      "scales": {
        "8": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ox.tz",
            "ldclc-v1-fp16-[H]x[W]-ox.tz"
          ],
          "blocks": [
            64,
            64
          ],
          "outputs": [
            "image",
            "netOutput"
          ]
        }
      }
    }
  }
}