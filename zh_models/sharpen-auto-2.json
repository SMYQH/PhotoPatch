{
  "jsonVersion": "1.0.0",
  "version": "2",
  "minAppVersion": "0",
  "shortName": "slsp_ap",
  "name": "Sharpen Standard Auto",
  "category": "自动参数计算",
  "verb": "正在计算最优锐化参数...",
  "autoModel": "slsp_ap",
  "display": 0,
  "enabled": 1,
  "padding": [
    0,
    0
  ],
  "zeroCenter": 1,
  "inputs": {
    "input": "netInput",
    "mask": "dummy"
  },
  "parameterNames": [
    "noise",
    "lensblur",
    "motionblur",
    "compression"
  ],
  "backends": {
    "openvino": {
      "model": "imap",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v3-fp32-[H]x[W]-ov.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "auto_param//auto_param/tail/tanh/Tanh"
          ]
        }
      }
    },
    "coreml": {
      "model": "imap",
      "parallel": 0,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "Identity"
          ]
        }
      }
    }
  }
}