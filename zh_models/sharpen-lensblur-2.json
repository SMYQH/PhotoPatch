{
  "jsonVersion": "1.0.0",
  "version": "3",
  "minAppVersion": "0",
  "shortName": "lensblur",
  "name": "Lens Blur v2",
  "category": "锐化强度",
  "verb": "正在执行细节锐化...",
  "autoModel": "slsp_ap",
  "blockOverlap": 128,
  "enabled": 1,
  "inputs": {
    "input0": "netInput",
    "noise": "t_param0",
    "blur": "t_param1",
    "grainsize": "t_param2"
  },
  "backends": {
    "coreml": {
      "model": "imn",
      "parallel": 0,
      "minMacVersion": 10.16,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ox.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "openvino": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ov.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "onnx": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ox.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    },
    "tensorrt": {
      "model": "imn",
      "parallel": 0,
      "capabilities": [
        705,
        806,
        809
      ],
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-rt[C]-[R]-rt.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "netOutput"
          ]
        }
      }
    }
  }
}