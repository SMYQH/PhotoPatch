{
  "jsonVersion": "1.0.0",
  "version": "1",
  "minAppVersion": "0",
  "shortName": "slb",
  "name": "Sharpen Refocus",
  "category": "锐化强度",
  "verb": "正在执行细节锐化...",
  "autoModel": "slsp_ap",
  "enabled": 1,
  "inputs": {
    "input": "netInput",
    "param1": "t_param",
    "param2": "t_param1"
  },
  "backends": {
    "onnx": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ox.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "tl_unet/netOutput"
          ]
        }
      }
    },
    "coreml": {
      "model": "imn",
      "parallel": 1,
      "minMacVersion": 10.16,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "tl_unet/netOutput"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ox.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "tl_unet/netOutput"
          ]
        }
      }
    },
    "openvino": {
      "model": "imn",
      "parallel": 1,
      "inputs": {
        "input0": "netInput",
        "t_param": "param"
      },
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ov.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "tl_unet/netOutput"
          ]
        }
      }
    },
    "openvino16": {
      "model": "imn",
      "parallel": 1,
      "inputs": {
        "input0": "netInput",
        "t_param": "param"
      },
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ov.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "tl_unet/netOutput"
          ]
        }
      }
    },
    "tensorrt": {
      "model": "imn",
      "parallel": 0,
      "capabilities": [
        705,
        806,
        809
