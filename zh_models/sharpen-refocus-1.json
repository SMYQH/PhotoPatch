      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-rt[C]-[R]-rt.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "tl_unet/netOutput"
          ]
        }
      }
    }
  }
}