{
  "jsonVersion": "1.0.0",
  "version": "2",
  "minAppVersion": "0",
  "shortName": "sstd",
  "name": "Sharpen Standard v2",
  "category": "锐化强度",
  "verb": "正在执行细节锐化...",
  "autoModel": "apnb",
  "enabled": 1,
  "inputs": {
    "input0": "input",
    "param1": "noise",
    "param2": "blur"
  },
  "backends": {
    "coreml": {
      "model": "imn",
      "parallel": 0,
      "minMacVersion": 10.16,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]_1-fp16-[H]x[W]-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "output"
          ]
        }
      }
    },
    "onnx": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ox.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "output"
          ]
        }
      }
    },
    "tensorrt": {
      "model": "imn",
      "parallel": 0,
      "capabilities": [
        705,
        806,
        809
      ],
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-rt[C]-[R]-rt.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "output"
          ]
        }
      }
    },
    "openvino": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ov.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "output"
          ]
        }
      }
    },
    "openvino16": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "1": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ov.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "output"
          ]
        }
      }
    }
  }
}