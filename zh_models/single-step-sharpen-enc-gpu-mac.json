{
  "jsonVersion": "1.0.0",
  "version": "1",
  "minCMLMacVersion": 10.16,
  "minAppVersion": "0",
  "shortName": "ssdenc-sharpen-gpu-mac",
  "name": "SingleStepSharpenEnc GPU Mac",
  "category": "锐化强度",
  "enabled": 1,
  "zeroCenter": 1,
  "padding": [
    0,
    0
  ],
  "blockOverlap": 128,
  "blockDiscard": 16,
  "inputs": {
    "input": "x"
  },
  "backends": {
    "coreml": {
      "model": "imn",
      "parallel": -2,
      "scales": {
        "0.125": {
          "nets": [
            "ssdenc-sharpen-v[V]-fp16-[H]x[W]-rev1-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "latent"
          ]
        }
      }
    }
  }
}