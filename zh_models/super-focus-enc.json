{
  "jsonVersion": "1.0.0",
  "version": "1",
  "minCMLMacVersion": 10.16,
  "minAppVersion": "0",
  "shortName": "spfcenc",
  "name": "SuperFocusEnc",
  "category": "超焦清晰重构",
  "enabled": 1,
  "zeroCenter": 1,
  "padding": [
    0,
    0
  ],
  "blockOverlap": 64,
  "blockDiscard": 8,
  "inputs": {
    "input": "input_image"
  },
  "backends": {
    "coreml": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "0.125": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-rev2-mlc.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "latent"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "0.125": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ox.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "latent"
          ]
        }
      }
    },
    "onnx": {
      "model": "imn",
      "parallel": 0,
      "scales": {
        "0.125": {
          "nets": [
            "[N]-v[V]-fp32-[H]x[W]-ox.tz2"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "latent"
          ]
        }
      }
    },
    "openvino16": {
      "model": "imn",
      "parallel": 1,
      "scales": {
        "0.125": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-ov.tz"
          ],
          "blocks": [
            512,
            512
          ],
          "outputs": [
            "latent"
          ]
        }
      }
    }
  }
}