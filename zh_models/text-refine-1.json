{
  "jsonVersion": "1.0.0",
  "version": "1",
  "minAppVersion": "0",
  "shortName": "trf",
  "blockOverlap": 8,
  "blockDiscard": 1,
  "enabled": 1,
  "name": "Text Refine",
  "category": "文本与字符修复",
  "verb": "正在保护与修复文字细节...",
  "gui": {
    "minScale": 2,
    "maxScale": 4,
    "showScale": 0,
    "name": "Text Refine",
    "displayPri": 1.0,
    "desc": "Text Refine model",
    "parameters": {
      "scale": {
        "default": 1
      },
      "param1": {
        "name": "降噪强度",
        "guiType": "int",
        "default": 0.5,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Reduce noises. Higher values are better for low-bitrate input video.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "param2": {
        "name": "锐化强度",
        "guiType": "int",
        "default": 0.3,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Additional sharpening of the video. Higher values produce a sharper video but may introduce artifacts. Adjust this after the \"Deblock\" setting.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      },
      "param3": {
        "name": "消除压缩杂讯",
        "guiType": "int",
        "default": 0.3,
        "guiMax": 100,
        "guiMin": 0,
        "description": "Reduce blockiness and other compression artifacts. Higher values are better for low-bitrate input video.",
        "precision": 1,
        "modelMax": 1,
        "modelMin": 0,
        "modelType": "float"
      }
    }
  },
  "inputs": {
    "param1": "pn",
    "param2": "pb",
    "param3": "pc",
    "input": "netInput",
    "cinput": "infer_input",
    "output": "infer_output"
  },
  "backends": {
    "openvino": {
      "model": "imcc",
      "parallel": 1,
      "scales": {
        "2": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ov.tz2",
            "gclc-v1-fp16-[H]x[W]-[S]x-ov.tz2"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
            "netOutput",
            "model/tf.clip_by_value/clip_by_value"
          ]
        },
        "4": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ov.tz2",
            "gclc-v1-fp16-[H]x[W]-[S]x-ov.tz2"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
            "netOutput",
            "model/tf.clip_by_value/clip_by_value"
          ]
        }
      }
    },
    "onnx16": {
      "model": "imcc",
      "parallel": 1,
      "scales": {
        "2": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ox.tz2",
            "gclc-v1-fp32-[H]x[W]-[S]x-ox.tz2"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
            "netOutput",
            "tf.clip_by_value"
          ]
        },
        "4": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-ox.tz2",
            "gclc-v1-fp32-[H]x[W]-[S]x-ox.tz2"
          ],
          "blocks": [
            128,
            128
          ],
          "outputs": [
            "netOutput",
            "tf.clip_by_value"
          ]
        }
      }
    },
    "coreml": {
      "model": "imcc",
      "parallel": 1,
      "minMacVersion": 10.16,
      "scales": {
        "2": {
          "nets": [
            "[N]-v[V]-fp16-[H]x[W]-[S]x-mlc.tz",
            "gclc-v1-fp16-[H]x[W]-[S]x-mlc.tz"
          ],
          "blocks": [
